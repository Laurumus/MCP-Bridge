{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "executor": {
      "id": "executor",
      "name": "Executor",
      "description": "Isolated executor for external task delegation. No shell, no file writes, no MCP, no subagents.",
      "mode": "primary",
      "hidden": true,
      "model": "opencode/longcat-2.5-free",
      "permissions": [
        { "action": "read", "resource": "file", "effect": "allow" },
        { "action": "write", "resource": "file", "effect": "deny" },
        { "action": "execute", "resource": "shell", "effect": "deny" },
        { "action": "*", "resource": "mcp:*", "effect": "deny" },
        { "action": "*", "resource": "subagent", "effect": "deny" },
        { "action": "question", "resource": "*", "effect": "deny" },
        { "action": "*", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
