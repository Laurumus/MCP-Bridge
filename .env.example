# Environment variables supported by the bridge code (see src/config.js).
#
# IMPORTANT: the bridge does NOT load a .env file on its own (there is no
# dotenv/dotenvx dependency). This file documents the variables; you must
# export them in the environment that starts the process, e.g.:
#   set -a; . ./.env; set +a; node src/main.js
# or put them in the systemd unit (Environment=/EnvironmentFile=).
#
# Copy to .env for local reference only; .env is git-ignored.
# Never put real secrets in this file in the repository.

# --- Bind address ------------------------------------------------------------
# Listen host. Default: 127.0.0.1 (loopback only).
BRIDGE_HOST=127.0.0.1
# Listen port. Default: 9999.
BRIDGE_PORT=9999

# --- Local state files -------------------------------------------------------
# Paths are resolved from the project root when left unset.
# SQLite task database. Default: <project>/tasks.db
#BRIDGE_DB_PATH=/path/to/tasks.db
# Bearer token file (auto-created with mode 0600 if missing). Default: <project>/.bearer_token
#BRIDGE_TOKEN_FILE=/path/to/.bearer_token
# Log file. Default: <project>/bridge.log
#BRIDGE_LOG_FILE=/path/to/bridge.log

# --- Executor identity (local only, never from the MCP client) ---------------
# OpenCode agent name. Default: executor
BRIDGE_EXECUTOR_AGENT=executor
# REQUIRED. OpenCode model reference "provider/model" (optionally
# "provider/model#variant"). There is NO default and no fallback: the bridge
# refuses to start, and refuses submissions, when this is missing, empty or
# malformed. Use a model your OpenCode provider is configured for; no provider
# key belongs in this file.
BRIDGE_EXECUTOR_MODEL=apmix/deepseek-v4.1-flash-1017
# Working directory passed to the `opencode api` subprocess. Default: <project>
#BRIDGE_WORKDIR=/home/user/work

# --- Timeouts (milliseconds; non-positive/invalid values fall back to default)
# Per `opencode api` call. Default: 30000
BRIDGE_OPENCODE_API_TIMEOUT_MS=30000
# Per task execution. Default: 300000
BRIDGE_TASK_EXECUTION_TIMEOUT_MS=300000
# Watchdog tick. Default: 3000
BRIDGE_WATCHDOG_INTERVAL_MS=3000

# --- Limits ------------------------------------------------------------------
# Max prompt length in characters. Default: 10000
BRIDGE_MAX_PROMPT_LENGTH=10000
# Max result payload length in characters. Default: 50000
BRIDGE_MAX_RESULT_LENGTH=50000
# Max HTTP request body size in bytes. Default: 1048576 (1 MiB)
BRIDGE_MAX_REQUEST_BODY_SIZE=1048576
# Max concurrent MCP sessions. Default: 100
BRIDGE_MAX_SESSIONS=100
